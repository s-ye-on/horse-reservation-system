# compose.prod.yaml 이 사용하는 환경변수 예시 파일이다.
# 실제 secret 은 이 파일에 넣지 않는다. Lightsail 서버에서 `.env` 로 복사한 뒤 실제 값을 입력한다.
# `.env` 는 Git 에 커밋하지 않는다(.gitignore 에 이미 포함되어 있다).
# JWT_SECRET 은 HS256 서명 키로 사용되므로 32 bytes 이상의 무작위 값이어야 한다.

MYSQL_DATABASE=horse
MYSQL_USER=horse
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

JWT_SECRET=replace_with_at_least_32_bytes_random_secret

SPRING_PROFILES_ACTIVE=prod
WEB_ALLOWED_ORIGINS=

# Initial admin bootstrap only.
# Enable bootstrap-admin only for the initial admin creation,
# then return SPRING_PROFILES_ACTIVE to prod and remove these credentials.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password

TZ=Asia/Seoul
