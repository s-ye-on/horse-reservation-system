{
  "openapi": "3.1.0",
  "info": {
    "title": "Horse Reservation API",
    "description": "마장 예약 서비스 API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/admin/members/{memberId}/riding-permissions": {
      "patch": {
        "tags": [
          "admin-member-riding-permission-controller"
        ],
        "operationId": "changeRidingPermissions",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRidingPermissionUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/eligible-classes": {
      "get": {
        "tags": [
          "member-available-riding-classes-controller"
        ],
        "operationId": "getAvailableRidingClasses",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MemberAvailableRidingClassesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/members": {
      "get": {
        "tags": [
          "admin-member-query-controller"
        ],
        "operationId": "getMembers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdminMemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/members/{memberId}": {
      "get": {
        "tags": [
          "admin-member-query-controller"
        ],
        "operationId": "getMember",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMemberResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MemberRidingPermissionUpdateRequest": {
        "type": "object",
        "properties": {
          "dressageApproved": {
            "type": "boolean"
          },
          "jumpingApproved": {
            "type": "boolean"
          }
        }
      },
      "AdminMemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "generalRideCount": {
            "type": "integer",
            "format": "int32"
          },
          "dressageRideCount": {
            "type": "integer",
            "format": "int32"
          },
          "jumpingRideCount": {
            "type": "integer",
            "format": "int32"
          },
          "dressageApproved": {
            "type": "boolean"
          },
          "jumpingApproved": {
            "type": "boolean"
          },
          "canUseLargeArena": {
            "type": "boolean"
          }
        }
      },
      "MemberAvailableRidingClassesResponse": {
        "type": "object",
        "properties": {
          "currentGeneralGrade": {
            "type": "string",
            "enum": [
              "FIRST_RIDE",
              "ROUND_BEGINNER",
              "ROUND_TROT",
              "LARGE_ARENA_BEGINNER",
              "LARGE_ARENA_TROT"
            ]
          },
          "dressageApproved": {
            "type": "boolean"
          },
          "jumpingApproved": {
            "type": "boolean"
          },
          "canUseLargeArena": {
            "type": "boolean"
          },
          "availableRidingClasses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "FIRST_RIDE",
                "ROUND_BEGINNER",
                "ROUND_TROT",
                "LARGE_ARENA_BEGINNER",
                "LARGE_ARENA_TROT",
                "DRESSAGE",
                "JUMPING"
              ]
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}