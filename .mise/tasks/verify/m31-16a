#!/usr/bin/env bash
#MISE description="Verify M31-16A backend authentication and initial admin bootstrap"
# Task name: verify:m31-16a

set -euo pipefail

mise run db:up
./backend/gradlew -p backend test \
  --tests '*AuthDomainTest' \
  --tests '*AuthApiIntegrationTest' \
  --tests '*AuthConcurrencyIntegrationTest' \
  --tests '*AuthMigrationIntegrationTest' \
  --tests '*AuthOpenApiContractTest' \
  --tests '*InitialAdminBootstrapIntegrationTest' \
  --tests '*InitialAdminBootstrapProfileIntegrationTest' \
  --tests '*SecurityBoundaryTest' \
  --tests '*ProdJwtSecretConfigurationTest' \
  --tests '*ProdProfileStartupIntegrationTest' \
  --tests '*ErrorResponseContractApiTest' \
  --tests '*ExceptionCodeTest'
pnpm --dir frontend/packages/api-client build:types
pnpm --dir frontend/apps/web typecheck
pnpm --dir frontend/apps/mobile typecheck

rg -Fq 'BOOTSTRAP_ADMIN_EMAIL' backend/src/main/java/com/horse/auth/InitialAdminBootstrapRunner.java
rg -Fq 'BOOTSTRAP_ADMIN_PASSWORD' backend/src/main/java/com/horse/auth/InitialAdminBootstrapRunner.java
rg -Fq 'token_hash CHAR(64)' \
  backend/src/main/resources/db/migration/V35__create_auth_accounts_and_refresh_sessions.sql

if rg -n 'BOOTSTRAP_ADMIN_(EMAIL|PASSWORD):[^}]' backend/src/main/resources README.md; then
  echo 'Bootstrap credentials must not have a stored fallback value.' >&2
  exit 1
fi
